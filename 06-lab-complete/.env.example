# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore — KHÔNG commit)
# Đây là giá trị mẫu, không phải secret thật.

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số worker uvicorn trong Docker (mặc định 1)
WEB_CONCURRENCY=1

# Security — đặt key thật trên platform (Railway/Render variables), không ghi vào code
AGENT_API_KEY=change-me-to-a-long-random-string

# Redis (docker compose tự đặt redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
